<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebarOperador') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <div id="clientes-table"></div>

      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>

  <script>
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { id: 'idcliente', hidden: true },
          { name: 'Nombre' },
          { name: 'RFC' },
          { name: 'Tipo' },
          { name: 'Correo' },
          { name: 'Teléfono' },
          { name: 'Riesgo' },
          { name: 'Estatus' },
          { name: 'Registrado' }
        ],
        data: <%- JSON.stringify(clientes.map(c => [
          c.idcliente,
          c.nombre_completo,
          c.rfc,
          c.tipo_persona === 'fisica' ? 'Física' : 'Moral',
          c.email        || '—',
          c.telefono     || '—',
          c.nivel_riesgo,
          c.estatus,
          new Date(c.created_at).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
})
        ])) %>,
        search: true,
        language: {
      search: {
        placeholder: 'Buscar por nombre, RFC, correo...'
      }
    },
        sort:   true,
        pagination: { limit: 10 }
      }).render(document.getElementById('clientes-table'));
    });
  </script>
</body>
</html>
