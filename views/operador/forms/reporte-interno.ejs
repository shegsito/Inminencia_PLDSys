<!DOCTYPE html>
<html lang="en">
    
<%- include('../../partials/head') %>

  <body>

    <div class = "entire-container">

        <%- include('../../partials/sidebarOperador') %>
        <div class = "right-container">

        <div class = "primary-content">
            <%- include('../../partials/header') %>
            <%- include('../../partials/back-button') %>
            <div class = "queja-form">

            <form method="POST" action="/operador/reportar" enctype="multipart/form-data">

                <div class="form-group">
                  <label for="fecha_int">Fecha del reporte</label>
                  <input type="date" id="fecha_int" name="fecha_int" required>
                </div>

                <div class="form-group">
                <label for="queja_desc">Describir con más detalle posible:</label>
                <textarea name="queja_desc" rows="4" placeholder="Descripción del caso..." required></textarea></div>

                <div class="form-group">
                <label for="evidencia">Adjuntar evidencia</label>
                <input type="file" name="evidencia" required accept=".jpg, .jpeg, .png, .pdf"></div>
                
                <button type="submit" class="form-submit-btn" id="form-submit">Enviar reporte</button>
            </form>
            </div>

        </div>

      </div>
      </div>

      <script src = "/scripts/forms-script.js"></script>
</body>
</html>