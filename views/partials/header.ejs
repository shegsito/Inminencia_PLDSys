<header>

    <div class = "top-row-header">
        
        <h1>Sistema de monitoreo</h1>

        <div class="buttons">
        <% if (typeof buttonText !== 'undefined' && !locals.readOnly) { %>
            <% if (typeof buttonLink !== 'undefined') { %>
                <a href = "<%= buttonLink %>"> 
                    <button class = "top-right-button"><%= buttonText %>
                    </button>
                </a>
            <% } else { %>
                <button class = "top-right-button"><%= buttonText %>
                    </button>
            <% }  %>
        <% } %>

       <!-- <a href = "/logout"><button class = "logout-button">Salir</button></a>-->
        </div>

    </div>
    
    <% if (typeof pageTitle !== 'undefined') { %>
        <h2 class="subtitle">
            <% if (typeof pageIcon !== 'undefined') { %>
                <i data-lucide="<%= pageIcon %>" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;"></i>
            <% } %>
            <%= pageTitle %>
        </h2>
    <% } %>

</header>