<script>
    window.addEventListener("load", () => {
  gridTable = new gridjs.Grid({
    columns: ["NOMBRE", "FOLIO", "PRODUCTOS", "MONTO", "FECHA", "ESTATUS"],
    search: true,
    sort: true,
    pagination: true,
    server: {
      url: '/operaciones',
      then: data => data.operaciones
    },
    style: {
      table: {
        'font-family': 'Cambria, serif'
      },
      th: {
        'background-color': '#4d0100',
        'color': 'white'
      }
    }
  }).render(document.getElementById("test-table"));
    });

</script>