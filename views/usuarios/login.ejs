<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>

  <!-- Loading overlay -->
  <div id="login-loading-overlay">
    <div class="login-loading-box">
      <div class="login-spinner"></div>
      <span class="login-loading-text">INMINENCIA</span>
    </div>
  </div>

  <div class="login-split">

    <!-- Left: form panel -->
    <div class="login-panel">

      <div class="login-brand">
        <span class="login-brand-title">INMINENCIA</span>
        <span class="login-brand-sub">SOFTWARE DEVELOPERS</span>
      </div>

      <div class="login-avatar">
        <i data-lucide="user-round"></i>
      </div>

      <h2 class="login-heading">Iniciar sesión</h2>

      <% if (error) { %>
        <div class="login-error">
          <i data-lucide="circle-alert" style="width:16px;height:16px;flex-shrink:0;"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/usuarios/login" method="POST" id="loginForm">

        <div class="login-field">
          <div class="login-input-wrap">
            <i data-lucide="user" class="login-input-icon"></i>
            <input type="text" id="email" name="email" placeholder="Usuario" required autocomplete="username">
          </div>
        </div>

        <div class="login-field">
          <div class="login-input-wrap">
            <i data-lucide="lock" class="login-input-icon"></i>
            <input type="password" id="password" name="password" placeholder="Contraseña" required autocomplete="current-password">
            <button type="button" class="login-show-pw" id="showPwBtn" aria-label="Mostrar contraseña">
              <i data-lucide="eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <div class="login-links">
          <a href="#" class="login-forgot">¿Olvidaste tu contraseña?</a>
        </div>

        <button type="submit" class="login-btn" id="loginBtn">Iniciar sesión</button>

      </form>

    </div>

    <!-- Right: decorative panel — change the background in login-form.css under .login-deco -->
    <div class="login-deco">
      <div class="login-deco-content">
        <h1>Bienvenido.</h1>
        <p>SVA LAW</p>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      lucide.createIcons();

      // Show / hide password
      var pwInput = document.getElementById('password');
      var showBtn = document.getElementById('showPwBtn');
      showBtn.addEventListener('click', function () {
        var isHidden = pwInput.type === 'password';
        pwInput.type = isHidden ? 'text' : 'password';
        showBtn.querySelector('i').setAttribute('data-lucide', isHidden ? 'eye-off' : 'eye');
        lucide.createIcons();
      });

      // Loading overlay + submit
      var form    = document.getElementById('loginForm');
      var btn     = document.getElementById('loginBtn');
      var overlay = document.getElementById('login-loading-overlay');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        btn.disabled = true;
        overlay.classList.add('visible');
        setTimeout(function () { form.submit(); }, 1000);
      });
    });
  </script>

</body>
</html>
