<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div style="min-height:100vh; background:#f5f0eb; display:flex; flex-direction:column;">


    <!-- Form content -->
    <div style="flex:1; padding:32px 40px; max-width:1100px; width:100%; margin:0 auto; box-sizing:border-box;">

      <h2 style="font-family:'Cambria', serif; font-size:26px; font-weight:700;
                 color:#1a1a1a; margin-bottom:4px;">Registra tus datos</h2>

      <p class="kyc-required-note">*Campo obligatorio</p>

      <!-- Tipo persona toggle -->
      <div class="tipo-toggle">
        <button type="button" class="tipo-toggle-btn active" id="btn-fisica" onclick="setTipo('fisica')">Física</button>
        <button type="button" class="tipo-toggle-btn"        id="btn-moral"  onclick="setTipo('moral')">Moral</button>
      </div>

      <form id="kyc-form">
        <div class="kyc-wrapper">

          <!-- ── Columna izquierda: campos ── -->
          <div class="kyc-fields">

            <p class="form-section-title">Datos de identificación</p>

            <div class="kyc-row">
              <div class="kyc-group">
                <label for="nombre">Nombre(s) *</label>
                <input type="text" id="nombre" name="nombre" placeholder="Nuvia">
              </div>
              <div class="kyc-group">
                <label for="apellido_paterno">Apellido paterno *</label>
                <input type="text" id="apellido_paterno" name="apellido_paterno" placeholder="Flores">
              </div>
            </div>

            <div class="kyc-group">
              <label for="apellido_materno">
                Apellido materno
                <span style="color:#aaa; font-size:11px;">(opcional)</span>
              </label>
              <input type="text" id="apellido_materno" name="apellido_materno" placeholder="Quiroga">
            </div>

            <!-- Fila física: RFC + CURP -->
            <div class="kyc-row" id="row-fisica">
              <div class="kyc-group">
                <label for="rfc">RFC</label>
                <input type="text" id="rfc" name="rfc"
                       placeholder="FOMN821210MQTLCV02" maxlength="13"
                       style="text-transform:uppercase">
              </div>
              <div class="kyc-group">
                <label for="curp">CURP</label>
                <input type="text" id="curp" name="curp"
                       placeholder="IUMA990512MHGTRB05" maxlength="18"
                       style="text-transform:uppercase">
              </div>
            </div>

            <!-- Fila moral: RFC + Razón social -->
            <div class="kyc-row" id="row-moral" style="display:none;">
              <div class="kyc-group">
                <label for="rfc-moral">RFC</label>
                <input type="text" id="rfc-moral" name="rfc"
                       placeholder="RFC de la empresa" maxlength="12"
                       style="text-transform:uppercase" disabled>
              </div>
              <div class="kyc-group">
                <label for="razon_social">Empresa S.A. de C.V.</label>
                <input type="text" id="razon_social" name="razon_social"
                       placeholder="Nombre de la empresa" disabled>
              </div>
            </div>

            <p class="form-section-title" style="margin-top:20px;">Domicilio</p>

            <div class="kyc-group">
              <label for="calle">Calle y número *</label>
              <input type="text" id="calle" name="calle" placeholder="Av. Juárez 400 Int. 3">
            </div>

            <div class="kyc-row">
              <div class="kyc-group">
                <label for="colonia">
                  Colonia
                  <span style="color:#aaa; font-size:11px;">(opcional)</span>
                </label>
                <input type="text" id="colonia" name="colonia" placeholder="Colonia">
              </div>
              <div class="kyc-group">
                <label for="municipio">Municipio / Alcaldía *</label>
                <input type="text" id="municipio" name="municipio" placeholder="Benito Juárez">
              </div>
            </div>

            <div class="kyc-row">
              <div class="kyc-group">
                <label for="estado">Estado *</label>
                <input type="text" id="estado" name="estado" placeholder="Jalisco">
              </div>
              <div class="kyc-group">
                <label for="cp">C.P. *</label>
                <input type="text" id="cp" name="cp" placeholder="67892" maxlength="5">
              </div>
            </div>

            <div class="kyc-group">
              <label for="pais">País *</label>
              <input type="text" id="pais" name="pais" value="México" placeholder="México">
            </div>

            <p class="form-section-title" style="margin-top:20px;">Datos de contacto</p>

            <div class="kyc-row">
              <div class="kyc-group">
                <label for="email_personal">Correo personal *</label>
                <input type="email" id="email_personal" name="email_personal"
                       placeholder="Escriba su correo personal">
              </div>
              <div class="kyc-group">
                <label for="telefono">Teléfono *</label>
                <input type="tel" id="telefono" name="telefono"
                       placeholder="Escriba su teléfono" maxlength="10">
              </div>
            </div>

            <div class="kyc-group">
              <label for="email_institucional">
                Correo institucional
                <span style="color:#aaa; font-size:11px;">(opcional)</span>
              </label>
              <input type="email" id="email_institucional" name="email_institucional"
                     placeholder="Escriba su correo institucional">
            </div>

            <div class="kyc-feedback" id="kyc-feedback"></div>

            <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
              <button type="submit" class="kyc-submit-btn" id="kyc-submit">Guardar</button>
              <button type="button" class="kyc-submit-btn" id="btn-finalizar"
                      style="display:none; opacity:0.45; cursor:not-allowed;"
                      disabled>Finalizar</button>
            </div>

          </div>

          <!-- ── Columna derecha: documentos ── -->
          <div class="kyc-docs">

            <p class="docs-title">Documentos</p>
            <p style="font-size:11px; color:#aaa; margin-bottom:10px;">Disponibles tras registrar sus datos</p>

            <p class="doc-label">Identificación Oficial (INE, pasaporte)</p>
            <div class="doc-card doc-card--locked" data-tipo="ine">
              <span class="doc-card-plus">+</span>
              <span class="doc-card-hint">Subir PDF o imagen</span>
            </div>

            <p class="doc-label">Comprobante de Domicilio</p>
            <div class="doc-card doc-card--locked" data-tipo="comprobante_domicilio">
              <span class="doc-card-plus">+</span>
              <span class="doc-card-hint">Subir PDF o imagen</span>
            </div>

            <div id="docs-moral" style="display:none;">
              <p class="doc-label">Acta constitutiva (persona moral)</p>
              <div class="doc-card doc-card--locked" data-tipo="acta_constitutiva">
                <span class="doc-card-plus">+</span>
                <span class="doc-card-hint">Subir PDF o imagen</span>
              </div>

              <p class="doc-label">Poderes notariales</p>
              <div class="doc-card doc-card--locked" data-tipo="poder_notarial">
                <span class="doc-card-plus">+</span>
                <span class="doc-card-hint">Subir PDF o imagen</span>
              </div>
            </div>

          </div>

        </div><!-- /kyc-wrapper -->
      </form>

    </div><!-- /content -->
  </div><!-- /layout -->

  <!-- ── Confirmation modal ── -->
  <div id="modal-confirmacion" style="display:none; position:fixed; inset:0;
       background:rgba(0,0,0,.6); z-index:1000;
       align-items:center; justify-content:center;">
    <div style="background:#4d0100; padding:2.5rem 2rem; border-radius:12px;
                max-width:440px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,.5);
                text-align:center;">

      <svg width="80" height="72" viewBox="0 0 100 90"
           style="margin-bottom:1.2rem; display:block; margin-left:auto; margin-right:auto;">
        <polygon points="50,8 92,82 8,82"
                 fill="none" stroke="rgba(200,200,200,0.75)"
                 stroke-width="5" stroke-linejoin="round"/>
        <line x1="50" y1="34" x2="50" y2="58"
              stroke="rgba(200,200,200,0.85)" stroke-width="6" stroke-linecap="round"/>
        <circle cx="50" cy="70" r="4" fill="rgba(200,200,200,0.85)"/>
      </svg>

      <p id="modal-mensaje" style="color:#fff; font-size:16px; font-weight:600; margin-bottom:1.8rem;"></p>

      <div style="display:flex; gap:16px; justify-content:center;">
        <button id="btn-cancelar"
                style="padding:10px 28px; border:2px solid rgba(255,255,255,0.45);
                       border-radius:6px; background:transparent; color:#fff;
                       cursor:pointer; font-size:14px; font-family:inherit; font-weight:500;">
          Cancelar
        </button>
        <button id="btn-confirmar"
                style="padding:10px 28px; border:none; border-radius:6px;
                       background:#fff; color:#4d0100; cursor:pointer;
                       font-size:14px; font-family:inherit; font-weight:700;">
          Aceptar
        </button>
      </div>
    </div>
  </div>

  <script>
    const sessionUserId  = '<%= usuario ? usuario.id  : "" %>';
    const sessionUserRol = '<%= usuario ? usuario.rol : "" %>';
    let tipoActual   = 'fisica';
    let sessionExpedId = null;

    // ── Modal helpers ─────────────────────────────────────────────────────────
    const modal    = document.getElementById('modal-confirmacion');
    const modalMsg = document.getElementById('modal-mensaje');
    let pendingAction = null;

    function abrirModal(mensaje, accion) {
      modalMsg.textContent = mensaje;
      pendingAction = accion;
      modal.style.display = 'flex';
    }

    function cerrarModal() {
      modal.style.display = 'none';
      pendingAction = null;
    }

    document.getElementById('btn-cancelar').addEventListener('click', cerrarModal);
    modal.addEventListener('click', e => { if (e.target === modal) cerrarModal(); });

    document.getElementById('btn-confirmar').addEventListener('click', async () => {
      const accion = pendingAction;
      cerrarModal();
      if (accion) await accion();
    });

    // ── Tipo persona toggle ───────────────────────────────────────────────────
    function setTipo(tipo) {
      tipoActual = tipo;
      document.getElementById('btn-fisica').classList.toggle('active', tipo === 'fisica');
      document.getElementById('btn-moral').classList.toggle('active',  tipo === 'moral');
      document.getElementById('docs-moral').style.display  = tipo === 'moral'  ? 'block' : 'none';
      document.getElementById('row-fisica').style.display  = tipo === 'fisica' ? 'flex'  : 'none';
      document.getElementById('row-moral').style.display   = tipo === 'moral'  ? 'flex'  : 'none';
      document.getElementById('curp').disabled         = tipo !== 'fisica';
      document.getElementById('rfc-moral').disabled    = tipo !== 'moral';
      document.getElementById('razon_social').disabled = tipo !== 'moral';
    }

    setTipo('fisica');

    // ── Form submit ───────────────────────────────────────────────────────────
    document.getElementById('kyc-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = Object.fromEntries(new FormData(e.target).entries());
      formData.tipo_persona = tipoActual;

      abrirModal('¿Sus datos están correctos?', async () => {
        const feedback = document.getElementById('kyc-feedback');
        const btn      = document.getElementById('kyc-submit');

        btn.disabled    = true;
        btn.textContent = 'Registrando...';
        feedback.className     = 'kyc-feedback';
        feedback.style.display = 'none';

        try {
          const resp = await fetch('/api/clientes', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-user-id':    sessionUserId,
              'x-user-rol':   sessionUserRol,
            },
            body: JSON.stringify(formData),
          });

          const json = await resp.json();

          if (resp.ok) {
            feedback.className     = 'kyc-feedback success';
            feedback.style.display = 'block';
            feedback.textContent   = 'Registro exitoso. Ahora puede subir sus documentos.';
            btn.textContent = 'Registrado';
            activarUploadDocs(json.idexpediente);
          } else {
            const msg = json.errores
              ? json.errores.join(' · ')
              : (json.error || 'Error al registrar');
            feedback.className     = 'kyc-feedback error';
            feedback.style.display = 'block';
            feedback.textContent   = msg;
            btn.disabled    = false;
            btn.textContent = 'Guardar';
          }
        } catch {
          feedback.className     = 'kyc-feedback error';
          feedback.style.display = 'block';
          feedback.textContent   = 'No se pudo conectar con el servidor.';
          btn.disabled    = false;
          btn.textContent = 'Guardar';
        }
      });
    });

    // ── Verificar si todos los docs visibles están subidos ───────────────────
    function verificarDocumentos() {
      const cards    = Array.from(document.querySelectorAll('.doc-card[data-tipo]'));
      const visibles = cards.filter(c => {
        const secMoral = c.closest('#docs-moral');
        return !secMoral || secMoral.style.display !== 'none';
      });
      const listas = visibles.length > 0 && visibles.every(c => c.classList.contains('doc-card--done'));
      const btn = document.getElementById('btn-finalizar');
      btn.disabled       = !listas;
      btn.style.opacity  = listas ? '1'           : '0.45';
      btn.style.cursor   = listas ? 'pointer'     : 'not-allowed';
    }

    document.getElementById('btn-finalizar').addEventListener('click', () => {
      window.location.href = '/cliente';
    });

    // ── Activar doc-cards tras registro ──────────────────────────────────────
    function activarUploadDocs(idExpediente) {
      sessionExpedId = idExpediente;
      document.getElementById('btn-finalizar').style.display = '';
      verificarDocumentos();

      document.querySelectorAll('.doc-card[data-tipo]').forEach(card => {
        card.classList.remove('doc-card--locked');

        const input = document.createElement('input');
        input.type   = 'file';
        input.accept = '.pdf,.jpg,.jpeg,.png';
        input.style.display = 'none';
        card.appendChild(input);

        card.addEventListener('click', () => {
          if (!card.classList.contains('doc-card--done') &&
              !card.classList.contains('doc-card--uploading')) {
            input.click();
          }
        });

        input.addEventListener('change', () => {
          const file = input.files[0];
          if (file) confirmarSubida(card, input, file);
        });
      });
    }

    function confirmarSubida(card, input, file) {
      abrirModal('¿Desea subir este documento?', () =>
        subirDocumento(card, input, file)
      );
    }

    async function subirDocumento(card, input, file) {
      const tipo = card.dataset.tipo;
      const hint = card.querySelector('.doc-card-hint');
      const plus = card.querySelector('.doc-card-plus');

      card.classList.add('doc-card--uploading');
      hint.textContent = 'Subiendo...';

      const formData = new FormData();
      formData.append('archivo',        file);
      formData.append('tipo_documento', tipo);

      try {
        const resp = await fetch(`/api/expediente/${sessionExpedId}/documentos`, {
          method: 'POST',
          headers: {
            'x-user-id':  sessionUserId,
            'x-user-rol': sessionUserRol,
          },
          body: formData,
        });

        const json = await resp.json();
        card.classList.remove('doc-card--uploading');

        if (resp.ok) {
          card.classList.add('doc-card--done');
          plus.textContent = '✓';
          hint.textContent = file.name;
          verificarDocumentos();
        } else {
          hint.textContent = json.error || 'Error al subir';
        }
      } catch {
        card.classList.remove('doc-card--uploading');
        hint.textContent = 'Error de conexión';
      } finally {
        input.value = '';
      }
    }
  </script>

</body>
</html>
