<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../../partials/sidebar') %>

    <div class="right-container">

      <%- include('../../partials/header') %>

      <div class="primary-content">

        <p class="kyc-required-note">*Campo obligatorio</p>

        <!-- Toggle Tipo de Persona -->
        <div class="tipo-toggle">
          <button type="button" class="tipo-toggle-btn active" id="btn-fisica" onclick="setTipo('fisica')">Física</button>
          <button type="button" class="tipo-toggle-btn"        id="btn-moral"  onclick="setTipo('moral')">Moral</button>
        </div>

        <form id="kyc-form">
          <div class="kyc-wrapper">

            <!-- ── Columna izquierda: campos ── -->
            <div class="kyc-fields">

              <p class="form-section-title">Datos de identificación</p>

              <div class="kyc-group">
                <label for="nombre_completo">Nombre Completo</label>
                <input type="text" id="nombre_completo" name="nombre_completo"
                       placeholder="Escriba su nombre completo">
              </div>

              <!-- Fila física: RFC + CURP -->
              <div class="kyc-row" id="row-fisica">
                <div class="kyc-group">
                  <label for="rfc">RFC</label>
                  <input type="text" id="rfc" name="rfc"
                         placeholder="Escriba su RFC" maxlength="13"
                         style="text-transform:uppercase">
                </div>
                <div class="kyc-group">
                  <label for="curp">CURP</label>
                  <input type="text" id="curp" name="curp"
                         placeholder="Escriba su CURP" maxlength="18"
                         style="text-transform:uppercase">
                </div>
              </div>

              <!-- Fila moral: RFC + Razón social -->
              <div class="kyc-row" id="row-moral" style="display:none;">
                <div class="kyc-group">
                  <label for="rfc-moral">RFC</label>
                  <input type="text" id="rfc-moral" name="rfc"
                         placeholder="RFC de la empresa" maxlength="12"
                         style="text-transform:uppercase" disabled>
                </div>
                <div class="kyc-group">
                  <label for="razon_social">Empresa S.A. de C.V.</label>
                  <input type="text" id="razon_social" name="razon_social"
                         placeholder="Empresa" disabled>
                </div>
              </div>

              <p class="form-section-title" style="margin-top:20px;">Datos de contacto</p>

              <div class="kyc-group">
                <label for="domicilio">Domicilio</label>
                <input type="text" id="domicilio" name="domicilio"
                       placeholder="Estado · Municipio · Colonia · Calle · Núm · C.P.">
              </div>

              <div class="kyc-row">
                <div class="kyc-group">
                  <label for="email_personal">Correo personal</label>
                  <input type="email" id="email_personal" name="email_personal"
                         placeholder="Escriba su correo personal">
                </div>
                <div class="kyc-group">
                  <label for="telefono">Teléfono</label>
                  <input type="tel" id="telefono" name="telefono"
                         placeholder="Escriba su teléfono">
                </div>
              </div>

              <div class="kyc-group">
                <label for="email_institucional">
                  Correo institucional
                  <span style="color:#aaa; font-size:11px;">(opcional)</span>
                </label>
                <input type="email" id="email_institucional" name="email_institucional"
                       placeholder="Escriba su correo institucional">
              </div>

              <div class="kyc-feedback" id="kyc-feedback"></div>

              <button type="submit" class="kyc-submit-btn" id="kyc-submit">
                Registrar cliente
              </button>

            </div>

            <!-- ── Columna derecha: documentos ── -->
            <div class="kyc-docs">

              <p class="docs-title">Documentos</p>
              <p style="font-size:11px; color:#aaa; margin-bottom:10px;">Disponibles tras registrar al cliente</p>

              <p class="doc-label">Identificación Oficial (INE, pasaporte)</p>
              <div class="doc-card doc-card--locked" data-tipo="ine">
                <span class="doc-card-plus">+</span>
                <span class="doc-card-hint">Subir PDF o imagen</span>
              </div>

              <p class="doc-label">Comprobante de Domicilio</p>
              <div class="doc-card doc-card--locked" data-tipo="comprobante_domicilio">
                <span class="doc-card-plus">+</span>
                <span class="doc-card-hint">Subir PDF o imagen</span>
              </div>

              <!-- Solo moral -->
              <div id="docs-moral" style="display:none;">
                <p class="doc-label">Acta constitutiva (persona moral)</p>
                <div class="doc-card doc-card--locked" data-tipo="acta_constitutiva">
                  <span class="doc-card-plus">+</span>
                  <span class="doc-card-hint">Subir PDF o imagen</span>
                </div>

                <p class="doc-label">Poderes notariales</p>
                <div class="doc-card doc-card--locked" data-tipo="poder_notarial">
                  <span class="doc-card-plus">+</span>
                  <span class="doc-card-hint">Subir PDF o imagen</span>
                </div>
              </div>

            </div>

          </div><!-- /kyc-wrapper -->
        </form>

      </div><!-- /primary-content -->

      
    </div><!-- /right-container -->
    <%- include('../../partials/footer') %>
  </div><!-- /entire-container -->

  <script>
    let tipoActual      = 'fisica';
    let sessionUserId   = null;
    let sessionExpedId  = null;

    // ── Tipo persona toggle ────────────────────────────────────────────
    function setTipo(tipo) {
      tipoActual = tipo;

      document.getElementById('btn-fisica').classList.toggle('active', tipo === 'fisica');
      document.getElementById('btn-moral').classList.toggle('active', tipo === 'moral');

      document.getElementById('row-fisica').style.display = tipo === 'fisica' ? 'flex'  : 'none';
      document.getElementById('row-moral').style.display  = tipo === 'moral'  ? 'flex'  : 'none';
      document.getElementById('docs-moral').style.display = tipo === 'moral'  ? 'block' : 'none';

      document.getElementById('curp').disabled        = tipo !== 'fisica';
      document.getElementById('rfc-moral').disabled   = tipo !== 'moral';
      document.getElementById('razon_social').disabled = tipo !== 'moral';
    }

    // ── RF-01: registrar cliente ───────────────────────────────────────
    document.getElementById('kyc-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const feedback = document.getElementById('kyc-feedback');
      const btn      = document.getElementById('kyc-submit');

      btn.disabled = true;
      btn.textContent = 'Registrando...';
      feedback.className = 'kyc-feedback';
      feedback.style.display = 'none';

      const data = Object.fromEntries(new FormData(e.target).entries());
      data.tipo_persona = tipoActual;

      try {
        const resp = await fetch('/api/clientes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const json = await resp.json();

        if (resp.ok) {
          feedback.className = 'kyc-feedback success';
          feedback.style.display = 'block';
          feedback.textContent = `Cliente registrado. Ahora suba los documentos requeridos.`;

          // Lock the form so no double-submit
          btn.textContent = 'Cliente registrado';

          // Activate document upload with the returned IDs
          activarUploadDocs(json.idexpediente, json.idusuario);
        } else {
          const msg = json.errores
            ? json.errores.join(' · ')
            : (json.error || 'Error al registrar');
          feedback.className = 'kyc-feedback error';
          feedback.style.display = 'block';
          feedback.textContent = msg;
          btn.disabled = false;
          btn.textContent = 'Registrar cliente';
        }
      } catch {
        feedback.className = 'kyc-feedback error';
        feedback.style.display = 'block';
        feedback.textContent = 'No se pudo conectar con el servidor.';
        btn.disabled = false;
        btn.textContent = 'Registrar cliente';
      }
    });

    // ── RF-02: activar doc-cards y manejar uploads ─────────────────────
    function activarUploadDocs(idExpediente, idUsuario) {
      sessionExpedId = idExpediente;
      sessionUserId  = idUsuario;

      document.querySelectorAll('.doc-card[data-tipo]').forEach(card => {
        card.classList.remove('doc-card--locked');

        const input = document.createElement('input');
        input.type   = 'file';
        input.accept = '.pdf,.jpg,.jpeg,.png';
        input.style.display = 'none';
        card.appendChild(input);

        card.addEventListener('click', () => {
          if (!card.classList.contains('doc-card--done') &&
              !card.classList.contains('doc-card--uploading')) {
            input.click();
          }
        });

        input.addEventListener('change', () => {
          const file = input.files[0];
          if (file) subirDocumento(card, input, file);
        });
      });
    }

    async function subirDocumento(card, input, file) {
      const tipo = card.dataset.tipo;
      const hint = card.querySelector('.doc-card-hint');
      const plus = card.querySelector('.doc-card-plus');

      card.classList.add('doc-card--uploading');
      hint.textContent = 'Subiendo...';

      const formData = new FormData();
      formData.append('archivo',  file);
      formData.append('tipo_documento', tipo);

      try {
        const resp = await fetch(`/api/expediente/${sessionExpedId}/documentos`, {
          method: 'POST',
          headers: {
            'x-user-id':  sessionUserId,
            'x-user-rol': 'cliente',
          },
          body: formData,
        });

        const json = await resp.json();

        card.classList.remove('doc-card--uploading');

        if (resp.ok) {
          card.classList.add('doc-card--done');
          plus.textContent = '✓';
          hint.textContent = file.name;
        } else {
          hint.textContent = json.error || 'Error al subir';
        }
      } catch {
        card.classList.remove('doc-card--uploading');
        hint.textContent = 'Error de conexión';
      } finally {
        input.value = ''; // allow re-selecting same file
      }
    }
  </script>

</body>
</html>
