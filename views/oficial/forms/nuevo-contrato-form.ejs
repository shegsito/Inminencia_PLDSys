<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../../partials/sidebar') %>

    <div class="right-container">

      <%- include('../../partials/header') %>

      <div class="primary-content">
        
        <form action="/oficial/new-contrato" method="POST" id="new-form">
          <div class="form-wrapper">

            <div class="form-fields">
              <p class="form-section-title">Datos de contrato</p>

              <!-- nombre y producto -->
              <div class="form-row" id="row-data">
              <div class="form-group">
                <label for="nombre_completo">Nombre Completo</label>
                <input type="text" id="nombre_completo" name="nombre_completo"
                       placeholder="Nombre completo del cliente">
              </div>

              <div class="form-group">
                  <label for="producto">Tipo de producto</label>
                  <select id="producto" name="producto">
                    <option value="credito_simple">credito simple</option>
                    <option value="credito_cuenta_corriente">credito cuenta corriente</option>
                  </select>
                </div>
              </div>

              <!-- fecha inicio y fin -->
              <div class="form-row" id="row-data">

                <div class="form-group">
                  <label for="fecha_init">Fecha inicio</label>
                  <input type="date" id="fecha_init" name="fecha_init">
                </div>

                <div class="form-group">
                  <label for="fecha_fin">Fecha fin</label>
                  <input type="date" id="fecha_fin" name="fecha_fin">
                </div>
              </div>

              <!-- Monto y estatus -->
              <div class="form-row" id="row-data">

                <div class="form-group">
                  <label for="monto">Monto</label>
                  <input type="number" id="monto" name="monto" step="0.01" min="0"
                         placeholder="Escriba el monto total">
                </div>

                <div class="form-group">
                  <label for="estatus">Estatus</label>
                  <select id="estatus" name="estatus">
                    <option value="vigente">Vigente</option>
                    <option value="vencido">Vencido</option>
                    <option value="cancelado">Cancelado</option>
                    <option value="en_revision">En revisión</option>
                  </select>
                </div>

              </div>              

              <div class="form-feedback" id="form-feedback"></div>

              <button type="submit" class="form-submit-btn" id="form-submit">
                Registrar Contrato
              </button>

            </div>

          </div><!-- /contrato-wrapper -->
        </form>

        </div>
    </div>
</div>
</body>
</html>