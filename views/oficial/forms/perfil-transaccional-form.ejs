<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head') %>
<body>
  <div class="entire-container">
    <%- include('../../partials/sidebar') %>
    <div class="right-container">
      <%- include('../../partials/header') %>
      <div class="primary-content">

          <%- include('../../partials/back-button') %>

          <div style="background-color: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 600px;">
              <h2 style="color: #4d0100; font-family: 'Cambria', serif; border-bottom: 2px solid #f3f4f6; padding-bottom: 10px;">Perfil Transaccional del Contrato</h2>
              
              <% if (success) { %>
                <div style="background-color: #dcfce7; color: #166534; padding: 15px; border-radius: 6px; margin-bottom: 20px;">Perfil actualizado correctamente.</div>
              <% } %>

              <form action="/oficial/contratos/perfil/<%= contrato.idcontrato %>" method="POST">
                  <input type="hidden" name="idcliente" value="<%= contrato.idcliente %>">
                  
                  <div style="margin-bottom: 20px;">
                      <label style="display: block; font-weight: bold; margin-bottom: 5px;">Monto Acumulado Mensual Esperado (MXN)</label>
                      <input type="number" step="0.01" name="monto_mensual_esperado" value="<%= contrato.monto_mensual_esperado || 0 %>" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 4px;" required>
                  </div>

                  <div style="margin-bottom: 30px;">
                      <label style="display: block; font-weight: bold; margin-bottom: 5px;">Frecuencia Mensual de Operaciones Esperadas</label>
                      <input type="number" name="frecuencia_mensual_esperada" value="<%= contrato.frecuencia_mensual_esperada || 0 %>" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 4px;" required>
                  </div>

                  <button type="submit" style="background-color: #4d0100; color: white; padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Guardar Perfil</button>
              </form>
          </div>
      </div>
    </div>
    <%- include('../../partials/footer') %>
  </div>
</body>
</html>