<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebar') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <div id="clientes-table"></div>

      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>

  <script>
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { id: 'idcliente', hidden: true },
          { name: 'Nombre' },
          { name: 'RFC' },
          { name: 'Tipo' },
          { name: 'Correo' },
          { name: 'Teléfono' },
          { name: 'Riesgo' },
          { name: 'Estatus' },
          { name: 'Registrado' },
          {
            name: 'Expediente',
            formatter: (_, row) =>
              gridjs.html(`<a href="/oficial/clientes/${row.cells[0].data}">Ver expediente</a>`)
          }
        ],
        data: <%- JSON.stringify(clientes.map(c => [
          c.idcliente,
          c.nombre_completo,
          c.rfc,
          c.tipo_persona === 'fisica' ? 'Física' : 'Moral',
          c.email        || '—',
          c.telefono     || '—',
          c.nivel_riesgo,
          c.estatus,
          new Date(c.created_at).toLocaleDateString('es-MX')
        ])) %>,
        search: true,
        language: {
      search: {
        placeholder: 'Buscar por nombre, RFC, correo...'
      }
    },
        sort:   true,
        pagination: { 
          summary: false,
          limit: 5 },
          className: {
            table: 'global-custom-table',
            th: 'global-custom-th',
            td: 'global-custom-td',
            search: 'global-custom-search'
        }
      }).render(document.getElementById('clientes-table'));
    });
  </script>
</body>
</html>
