<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>
<script src="/scripts/alertas-sse-oficial.js"></script>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebar') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <div id="clientes-table"></div>

      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>

  <script>
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { id: 'idcliente', hidden: true },
          { name: 'Nombre' },
          { name: 'RFC' },
          { name: 'Tipo' },
          { name: 'Correo' },
          { name: 'Teléfono' },
          { 
            name: 'Riesgo',
            // Formatter to display risk level with color coding
            formatter: (cell) => {
                        const val = cell ? cell.toLowerCase().trim() : 'bajo';
                        if (val === "alta") {
                            return gridjs.html(`<span style="background-color: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;">Alta</span>`);
                        } else if (val === "media") {
                            return gridjs.html(`<span style="background-color: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;">Media</span>`);
                        } else {
                            return gridjs.html(`<span style="background-color: #dcfce7; color: #166534; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;">Baja</span>`);
                        }
                    }
            },
          { name: 'Estatus' },
          { name: 'Registrado' },
          {
            name: 'Expediente',
            formatter: (_, row) =>
              gridjs.html(`<a href="/oficial/clientes/${row.cells[0].data}">Ver expediente</a>`)
          }
        ],
        data: <%- JSON.stringify(clientes.map(c => [
          c.idcliente,
          c.nombre_completo,
          c.rfc,
          c.tipo_persona === 'fisica' ? 'Física' : 'Moral',
          c.email        || '—',
          c.telefono     || '—',
          c.nivel_riesgo, // Passes live database calculation to the column formatter above
          c.estatus,
          new Date(c.created_at).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
})
        ])) %>,
        search: true,
        language: {
      search: {
        placeholder: 'Buscar por nombre, RFC, correo...'
      }
    },
        sort:   true,
        pagination: { 
          summary: false,
          limit: 5 },
          className: {
            table: 'global-custom-table',
            th: 'global-custom-th',
            td: 'global-custom-td',
            search: 'global-custom-search'
        }
      }).render(document.getElementById('clientes-table'));
    });
  </script>
</body>
</html>