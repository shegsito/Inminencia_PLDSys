<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebar') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <div id="clientes-table"></div>

      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>

  <script>
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { id: 'idcliente', hidden: true },
          { name: 'Nombre' },
          { name: 'RFC' },
          { name: 'Tipo' },
          { name: 'Correo' },
          { name: 'Teléfono' },
          { 
            name: 'Riesgo',
            // Formatter to display risk level with color coding
            formatter: (cell) => {
              const val = cell ? cell.toLowerCase().trim() : 'bajo';
              if (val === 'alto') {
                return gridjs.html(`<span style="color: #dc2626; font-weight: bold; text-transform: capitalize;">Alto</span>`);
              } else if (val === 'medio') {
                return gridjs.html(`<span style="color: #d97706; font-weight: bold; text-transform: capitalize;">Medio</span>`);
              } else {
                return gridjs.html(`<span style="color: #16a34a; font-weight: bold; text-transform: capitalize;">Bajo</span>`);
              }
            }
          },
          { name: 'Estatus' },
          { name: 'Registrado' },
          {
            name: 'Expediente',
            formatter: (_, row) =>
              gridjs.html(`<a href="/oficial/clientes/${row.cells[0].data}">Ver expediente</a>`)
          }
        ],
        data: <%- JSON.stringify(clientes.map(c => [
          c.idcliente,
          c.nombre_completo,
          c.rfc,
          c.tipo_persona === 'fisica' ? 'Física' : 'Moral',
          c.email        || '—',
          c.telefono     || '—',
          c.nivel_riesgo, // Passes live database calculation to the column formatter above
          c.estatus,
          new Date(c.created_at).toLocaleDateString('es-MX')
        ])) %>,
        search: true,
        sort:   true,
        pagination: { 
          summary: false,
          limit: 5 },
        style: {
          table: { 'font-family': 'Cambria, serif' },
          th:    { 'background-color': '#4d0100', 'color': 'white', 'font-size': '18px' },
          td:    { 'font-size': '16px' }
        }
      }).render(document.getElementById('clientes-table'));
    });
  </script>
</body>
</html>