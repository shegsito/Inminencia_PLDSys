<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebar') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <form method="GET" action="/admin/bitacora" class="bitacora-filtros">

          <div class="bitacora-filtro-input">
            <input
              type="text"
              name="nombre"
              placeholder="Buscar usuario..."
              value="<%= filtros.nombre || '' %>"
            />
          </div>

          <select name="accion">
            <option value="">Todas las acciones</option>
            <% acciones.forEach(a => { %>
              <option value="<%= a %>" <%= filtros.accion === a ? 'selected' : '' %>><%= a %></option>
            <% }) %>
          </select>

          <select name="entidad">
            <option value="">Todas las entidades</option>
            <% entidades.forEach(e => { %>
              <option value="<%= e %>" <%= filtros.entidad === e ? 'selected' : '' %>><%= e %></option>
            <% }) %>
          </select>

          <input type="date" name="fechaInicio" value="<%= filtros.fechaInicio || '' %>" />
          <input type="date" name="fechaFin"    value="<%= filtros.fechaFin    || '' %>" />

          <button type="submit" class="bitacora-btn-filtrar">Filtrar</button>
          <a href="/admin/bitacora" class="bitacora-btn-limpiar">Limpiar</a>

        </form>

        <div id="bitacora-table"></div>

      </div>
    </div>

    <%- include('../partials/footer') %>

  </div>

  <script>
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { name: 'Fecha y hora' },
          { name: 'Usuario' },
          { name: 'Acción' },
          { name: 'Entidad' },
          { name: 'ID Afectado' },
          { name: 'IP Origen' },
        ],
        data: <%- JSON.stringify(registros.map(r => [
          new Date(r.fecha).toLocaleString('es-MX'),
          r.nombre_usuario,
          r.accion,
          r.entidad_afect || '—',
          r.id_entidad    || '—',
          r.ip_origen     || '—',
        ])) %>,
        search: false,
        sort:   true,
        pagination: { limit: 15, summary: false },
        style: {
          table: { 'font-family': 'Cambria, serif' },
          th:    { 'background-color': '#4d0100', 'color': 'white', 'font-size': '18px' },
          td:    { 'font-size': '16px' }
        }
      }).render(document.getElementById('bitacora-table'));
    });
  </script>

</body>
</html>
