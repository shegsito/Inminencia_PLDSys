<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

<body>
  <div class="entire-container">

    <%- include('../partials/sidebar') %>

    <div class="right-container">

      <%- include('../partials/header') %>

      <div class="primary-content">

        <% if (!locals.readOnly) { %>
        <!-- ── Botón toggle ── -->
        <div style="margin-bottom:14px;">
          <button id="btn-toggle-form" type="button" class="gestionar-btn-guardar"
                  style="display:inline-flex;align-items:center;gap:8px;padding:9px 20px;">
            <i data-lucide="user-plus" style="width:16px;height:16px;"></i>
            Agregar usuario
          </button>
        </div>

<!-- ── Formulario nuevo usuario ── -->
        <div class="gestionar-form-card" id="form-nuevo-usuario-card" style="display:none; margin-bottom:20px;">
          <div class="gestionar-form-header">
            <h3>Nuevo usuario</h3>
          </div>

          <form id="form-nuevo-usuario" novalidate autocomplete="off">
            <div class="gestionar-form-grid">
              <div class="gestionar-form-field">
                <label>Nombre</label>
                <input id="f-nombre" type="text" placeholder="Ingresa su nombre completo" autocomplete="off" />
              </div>
              <div class="gestionar-form-field">
                <label>Contraseña temporal</label>
                <input id="f-password" type="password" placeholder="Ingresa su contraseña temporal" autocomplete="new-password" />
              </div>
              <div class="gestionar-form-field">
                <label>Email</label>
                <input id="f-email" type="email" placeholder="Ingresa su email" autocomplete="off" />
              </div>
              <div class="gestionar-form-field">
                <label>Rol</label>
                <select id="f-rol">
                  <option value="">Selecciona su rol</option>
                  <option value="oficial">Oficial</option>
                  <option value="operador">Operador</option>
                  <option value="auditor">Auditor</option>
                  <option value="cliente">Cliente</option>
                </select>
              </div>
            </div>
            <p id="form-error" class="gestionar-form-error" style="display:none;"></p>
            <p id="form-success" style="display:none; color:#1a7a1a; font-weight:600; margin-top:.6rem; text-align:center;"></p>
            <div style="text-align:center; margin-top:1.2rem;">
              <button type="button" id="btn-guardar-usuario" class="gestionar-btn-guardar">Guardar</button>
            </div>
          </form>
        </div>
        <% } %>
        
        <!-- ── Tabla usuarios ── -->
        <div id="gestionar-table"></div>

        

      </div><!-- primary-content -->

      <%- include('../partials/footer') %>

    </div><!-- right-container -->

  </div><!-- entire-container -->

  <!-- ── Modal de confirmación ── -->
  <div id="modal-confirmacion" style="display:none; position:fixed; inset:0;
       background:rgba(0,0,0,.6); z-index:1000;
       align-items:center; justify-content:center;">
    <div style="background:#4d0100; padding:2.5rem 2rem; border-radius:12px;
                max-width:400px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,.5);
                text-align:center;">

      <svg width="80" height="72" viewBox="0 0 100 90" style="margin-bottom:1.2rem; display:block; margin-left:auto; margin-right:auto;">
        <polygon points="50,8 92,82 8,82"
                 fill="none" stroke="rgba(200,200,200,0.75)"
                 stroke-width="5" stroke-linejoin="round"/>
        <line x1="50" y1="34" x2="50" y2="58"
              stroke="rgba(200,200,200,0.85)" stroke-width="6" stroke-linecap="round"/>
        <circle cx="50" cy="70" r="4" fill="rgba(200,200,200,0.85)"/>
      </svg>

      <p id="modal-mensaje" style="color:#fff; font-size:16px; font-weight:600; margin-bottom:1.8rem;"></p>

      <div style="display:flex; gap:16px; justify-content:center;">
        <button id="btn-cancelar"
                style="padding:10px 28px; border:2px solid rgba(255,255,255,0.45);
                       border-radius:6px; background:transparent; color:#fff;
                       cursor:pointer; font-size:14px; font-family:inherit; font-weight:500;">
          Cancelar
        </button>
        <button id="btn-confirmar"
                style="padding:10px 28px; border:none; border-radius:6px;
                       background:#fff; color:#4d0100; cursor:pointer;
                       font-size:14px; font-family:inherit; font-weight:700;">
          Aceptar
        </button>
      </div>
    </div>
  </div>

  <script>
    window.isAuditor = <%- locals.readOnly ? 'true' : 'false' %>;

    // ── Tabla Grid.js ──────────────────────────────────────────────────────────
    window.addEventListener('load', () => {
      new gridjs.Grid({
        columns: [
          { id: 'id',        hidden: true },
          { id: 'propio',    hidden: true },
          { id: 'isAdmin',   hidden: true },
          { id: 'activoRaw', hidden: true },
          { name: 'Nombre' },
          { name: 'Email' },
          { name: 'Rol' },
          {
            name: 'Activo',
            formatter: (cell, row) => {
              const id     = row.cells[0].data;
              const propio = row.cells[1].data;
              const isAdm  = row.cells[2].data;
              const activo = row.cells[3].data;
              if (!propio && !isAdm) {
                return gridjs.html(
                  `<span class="badge-activo ${activo ? 'badge-activo--true' : 'badge-activo--false'}"
                         data-id="${id}" data-activo="${activo}"
                         title="Clic para ${activo ? 'desactivar' : 'activar'}"
                   >${cell}</span>`
                );
              }
              return gridjs.html(
                `<span class="badge-activo badge-activo--readonly ${activo ? 'badge-activo--true' : 'badge-activo--false'}"
                 >${cell}</span>`
              );
            }
          },
          { name: 'Creado' },
        ],
        data: <%- JSON.stringify(usuarios.map(u => [
          u.idusuario,
          u.idusuario === usuario.id,
          u.rol === 'admin',
          u.activo,
          u.nombre,
          u.email,
          u.rol.charAt(0).toUpperCase() + u.rol.slice(1),
          u.activo ? 'Activo' : 'Inactivo',
          new Date(u.created_at).toLocaleDateString('es-MX', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
})
        ])) %>,
        search: true,
        sort:   true,
        language: {
      search: {
        placeholder: 'Buscar por nombre, correo, rol...'
      }
    },
        pagination: { limit: 10, summary: false },
        style: {
          table: { 'font-family': 'Cambria, serif' },
          th:    { 'background-color': '#4d0100', 'color': 'white', 'font-size': '18px' },
          td:    { 'font-size': '16px' }
        }
      }).render(document.getElementById('gestionar-table'));

      // Badge click — delegation on container so persiste tras re-renders de Grid.js
      document.getElementById('gestionar-table').addEventListener('click', e => {
        if (window.isAuditor) return;
        const badge = e.target.closest('.badge-activo:not(.badge-activo--readonly)');
        if (!badge) return;

        const id     = badge.dataset.id;
        const activo = badge.dataset.activo === 'true';
        const accion = activo ? 'desactivar' : 'activar';

        abrirModal(
          `¿Estás seguro de ${accion} el usuario?`,
          async () => {
            try {
              const res = await fetch(`/admin/usuarios/${id}/activo`, { method: 'PATCH' });
              if (!res.ok) {
                const data = await res.json();
                alert(data.error || 'Error al cambiar estado');
                return;
              }
              location.reload();
            } catch {
              alert('Error de red');
            }
          }
        );
      });
    });

    // ── Modal helpers ──────────────────────────────────────────────────────────
    const modal     = document.getElementById('modal-confirmacion');
    const modalMsg  = document.getElementById('modal-mensaje');
    const btnCancel = document.getElementById('btn-cancelar');
    const btnOk     = document.getElementById('btn-confirmar');

    let pendingAction = null;

    function abrirModal(mensaje, accion) {
      modalMsg.textContent = mensaje;
      pendingAction = accion;
      modal.style.display = 'flex';
    }

    function cerrarModal() {
      modal.style.display = 'none';
      pendingAction = null;
    }

    btnCancel.addEventListener('click', cerrarModal);
    modal.addEventListener('click', e => { if (e.target === modal) cerrarModal(); });

    btnOk.addEventListener('click', async () => {
      if (!pendingAction) return;
      const accion = pendingAction;
      cerrarModal();
      await accion();
    });

    // ── Toggle formulario ─────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => { lucide.createIcons(); });

    document.getElementById('btn-toggle-form').addEventListener('click', () => {
      const card = document.getElementById('form-nuevo-usuario-card');
      const visible = card.style.display !== 'none';
      card.style.display = visible ? 'none' : 'block';
    });

    // ── Nuevo usuario ──────────────────────────────────────────────────────────
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const formError   = document.getElementById('form-error');
    const formSuccess = document.getElementById('form-success');

    function mostrarError(msg) {
      formSuccess.style.display = 'none';
      formError.textContent = msg;
      formError.style.display = 'block';
    }

    function limpiarError() {
      formError.style.display = 'none';
    }

    function mostrarExito(email) {
      formError.style.display = 'none';
      formSuccess.textContent = `${email} registrado exitosamente`;
      formSuccess.style.display = 'block';
    }

    document.getElementById('btn-guardar-usuario').addEventListener('click', () => {
      limpiarError();
      const nombre   = document.getElementById('f-nombre').value.trim();
      const email    = document.getElementById('f-email').value.trim();
      const password = document.getElementById('f-password').value;
      const rol      = document.getElementById('f-rol').value;

      if (!nombre)                       return mostrarError('El nombre es obligatorio');
      if (!email || !EMAIL_RE.test(email)) return mostrarError('Email inválido');
      if (!password || password.length < 8) return mostrarError('La contraseña debe tener mínimo 8 caracteres');
      if (!rol)                          return mostrarError('Selecciona un rol');

      abrirModal(
        '¿Esta seguro de registrar a un nuevo usuario?',
        async () => {
          try {
            const res = await fetch('/admin/usuarios', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ nombre, email, password, rol }),
            });
            if (!res.ok) {
              const data = await res.json();
              mostrarError(data.error || 'Error al crear usuario');
              return;
            }
            mostrarExito(email);
            document.getElementById('f-nombre').value   = '';
            document.getElementById('f-email').value    = '';
            document.getElementById('f-password').value = '';
            document.getElementById('f-rol').value      = '';
            document.getElementById('form-nuevo-usuario-card').style.display = 'none';
            setTimeout(() => location.reload(), 2000);
          } catch {
            mostrarError('Error de red');
          }
        }
      );
    });
  </script>

</body>
</html>
